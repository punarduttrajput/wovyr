[82.786,"o","  \u001b[31m✗\u001b[0m \u001b[2mseq   1\u001b[0m  \u001b[1mui.frame.block            \u001b[0m\u001b[90muif-ffb833a180ec02ca      \u001b[0m\u001b[2mprev e3af9566… → cdaa4ea8…\u001b[0m\r\n"]
