[82.911,"o","  \u001b[32m✓\u001b[0m \u001b[2mseq   3\u001b[0m  \u001b[1mui.frame.present          \u001b[0m\u001b[90muif-312ea719291448d8:9ca  \u001b[0m\u001b[2mprev 245cda8a… → 40f7ab69…\u001b[0m\r\n"]
[82.974,"o","  \u001b[32m✓\u001b[0m \u001b[2mseq   4\u001b[0m  \u001b[1mui.decision.submit        \u001b[0m\u001b[90muif-312ea719291448d8:9ca  \u001b[0m\u001b[2mprev 40f7ab69… → d57c1023…\u001b[0m\r\n"]
[83.036,"o","\r\n"]
[83.099,"o","  \u001b[32m✓\u001b[0m chain verified client-side: 5 entries, 4/4 prev_hash values match their predecessor\r\n"]
[83.163,"o","  \u001b[90meach hash is a keyed HMAC, so an attacker with full write access to the log\u001b[0m\r\n"]
[83.226,"o","  \u001b[90mcan neither forge an interior entry (no key) nor truncate the tail undetected\u001b[0m\r\n"]
[83.289,"o","  \u001b[90m(a monotonic head anchor is written separately on every append).\u001b[0m\r\n"]
[88.042,"o","\r\n"]
[88.103,"o","\u001b[1m\u001b[32m══════════════════════════════════════════════════════════════════════════\u001b[0m\r\n"]
[88.166,"o","\u001b[1m  What just happened, in one line each:\u001b[0m\r\n"]
[88.23,"o","  \u001b[31m✗\u001b[0m a credential input never reached a human — structurally impossible\r\n"]
[88.293,"o","  \u001b[32m✓\u001b[0m a legitimate frame rendered, hashed, and pended durably\r\n"]
[88.357,"o","  \u001b[32m✓\u001b[0m kill -9 changed nothing: same frame_id, same frame_hash\r\n"]
[88.419,"o","  \u001b[31m✗\u001b[0m an undeclared action was refused before the workflow saw it\r\n"]
[88.482,"o","  \u001b[32m✓\u001b[0m every step is provable to an auditor, in order, tamper-evident\r\n"]
[88.545,"o","\u001b[1m\u001b[32m══════════════════════════════════════════════════════════════════════════\u001b[0m\r\n"]
