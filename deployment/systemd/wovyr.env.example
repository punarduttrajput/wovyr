# Environment file for the wovyr.service systemd unit (RM-AIM-P3 DEP-301).
#
# install.sh copies this to /etc/wovyr/wovyr.env (0640, root:wovyr) on first
# install only — it never overwrites an existing /etc/wovyr/wovyr.env on a
# re-run, so your edits here are safe across upgrades. See
# ../../docs/12-deployment/systemd.md for the full walkthrough of what each
# of these does and when you need it.

# --- Required ----------------------------------------------------------------

# Substituted directly into the unit's ExecStart (`wovyr dev --addr
# $WOVYR_BIND_ADDR`) — must always be set, or the service fails to start with
# no bind address at all. 127.0.0.1 (loopback-only) is the safe default: the
# server refuses to bind any other address unless TLS or
# WOVYR_TLS_TERMINATED_UPSTREAM is also configured below (SEC-202).
WOVYR_BIND_ADDR=127.0.0.1:8080

# --- Authentication (crates/wovyr-server/src/auth.rs) --------------------------
# Default is `disabled-loopback`: raw X-Wovyr-Tenant/X-Wovyr-Principal headers,
# trusted verbatim — fine for a loopback-only bind an operator alone can
# reach, not for anything else. Set one of the two real modes below before
# exposing this node beyond localhost.

# WOVYR_AUTH_MODE=apikey
# Mint keys with: sudo -u wovyr wovyr auth create-key <principal>

# WOVYR_AUTH_MODE=jwt
# WOVYR_JWT_HS_SECRET=change-me-to-a-real-secret
# # ...or, for RS256:
# # WOVYR_JWT_RS_PUBLIC_KEY=/etc/wovyr/jwt-public-key.pem
# WOVYR_JWT_ISSUER=
# WOVYR_JWT_AUDIENCE=

# Comma-separated principals treated as platform admins (org/project admin
# scopes without an explicit membership row). Leave unset in production.
# WOVYR_PLATFORM_ADMINS=

# Only relevant with disabled-loopback mode on a *non*-loopback bind — the
# server refuses to start in that combination unless this is also set to 1.
# Prefer a real auth mode instead of reaching for this.
# WOVYR_ALLOW_ANONYMOUS=1

# --- TLS (crates/wovyr-server/src/lib.rs) --------------------------------------
# Required (one of TLS or WOVYR_TLS_TERMINATED_UPSTREAM) to bind a non-loopback
# WOVYR_BIND_ADDR at all.

# WOVYR_TLS_CERT=/etc/wovyr/tls/fullchain.pem
# WOVYR_TLS_KEY=/etc/wovyr/tls/privkey.pem

# Set this instead of the two above if a reverse proxy in front of this node
# already terminates TLS.
# WOVYR_TLS_TERMINATED_UPSTREAM=1

# --- KMS root key (docs/13-security/encryption.md §5) -------------------------
# Unset: a root key is generated on first use and persisted to
# /var/lib/wovyr/.wovyr/kms/root.key — fine for evaluation, but that file is
# then the *only* copy of the key protecting every sealed secret/memory
# record. For anything you intend to keep, generate a key with a real secrets
# manager/HSM and set it here *before* the appliance ever seals real data —
# see docs/12-deployment/backup-and-restore.md §3 for the full escrow story.
# WOVYR_KMS_ROOT_KEY=

# --- LLM providers (crates/wovyr-provider) -------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# WOVYR_PROVIDER=anthropic

# OPENAI_API_KEY is used for *any* OpenAI-compatible endpoint, not just OpenAI —
# set WOVYR_OPENAI_BASE_URL to point it elsewhere. The base URL must be the API
# root that `/chat/completions` hangs off, e.g.:
#   https://api.groq.com/openai/v1                      (Groq)
#   https://openrouter.ai/api/v1                        (OpenRouter)
#   https://api.mistral.ai/v1                           (Mistral)
#   https://generativelanguage.googleapis.com/v1beta/openai   (Gemini — note, not /v1)
# WOVYR_OPENAI_BASE_URL=

# --- Embeddings, for memory/RAG (crates/wovyr-provider/src/gateway.rs) ---------
# Only needed if you use the memory engine. Embeddings resolve independently of
# the chat provider, because the two capabilities frequently don't live in the
# same place.
#
# Why this exists: every OpenAI-compatible backend reports the same provider name
# internally, so they all defaulted to `text-embedding-3-small` — a model only
# OpenAI itself serves. On Groq, Gemini, OpenRouter or Ollama that produced a 404
# on every `memory put`/`query` and on any agent with a `memory:` block.
#
# Pin whatever model your embedding endpoint actually serves:
#   text-embedding-3-small   OpenAI
#   text-embedding-004       Gemini (OpenAI-compat layer)
#   mistral-embed            Mistral
#   nomic-embed-text         Ollama (after `ollama pull nomic-embed-text`)
# WOVYR_EMBEDDING_MODEL=
#
# Set these two as well when your *chat* provider has no embeddings endpoint at
# all — Groq and Anthropic don't — to route embeddings somewhere that does while
# chat stays put. The key is optional; a local embedder usually ignores it.
# WOVYR_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# WOVYR_EMBEDDING_API_KEY=
#
# Note the retrieval strategy still matters: `keyword` never embeds at all, so it
# keeps working on a provider with no embeddings, while `hybrid` and `vector`
# require the above to be configured correctly.

# --- Logging (crates/wovyr-telemetry) ------------------------------------------
# WOVYR_LOG=info
# WOVYR_LOG_FORMAT=json

# --- Optional hardening / scale knobs ------------------------------------------
# CORS allow-list (default: no configured origins means no CORS headers at all).
# WOVYR_CORS_ALLOWED_ORIGINS=

# How long graceful shutdown waits for in-flight requests to drain (must stay
# below the unit's TimeoutStopSec above).
# WOVYR_SHUTDOWN_GRACE_SECS=30

# Enables the `shell` builtin tool for every agent run on this node — real
# command execution. Off by default; see the unit file's sandboxing note
# before turning this on.
# WOVYR_ENABLE_SHELL_TOOL=1

# Fleet-wide (Redis-shared) rate limiting / concurrency quotas — only takes
# effect if this binary was built with the `redis` cargo feature.
# WOVYR_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379
# WOVYR_QUOTA_REDIS_URL=redis://127.0.0.1:6379

# Shared marketplace registry across a fleet — only takes effect if this
# binary was built with the `postgres` cargo feature.
# WOVYR_MARKETPLACE_POSTGRES_URL=postgres://user:pass@host/wovyr_marketplace
