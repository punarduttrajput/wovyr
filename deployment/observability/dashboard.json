{
  "title": "Wovyr — RED + LLM Cost/Tokens",
  "uid": "wovyr-red-llm",
  "description": "Starter dashboard (RM-GA-P4 OBS-803) over the series RM-GA-P4 OBS-801's `hardening::track_metrics` and the LLM/webhook counters emit. Import into Grafana with a Prometheus datasource named `Prometheus` (or edit each panel's `datasource` field to match an existing one).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["wovyr", "red", "llm"],
  "templating": {
    "list": [
      {
        "name": "route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(wovyr_api_requests_total, route)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(wovyr_api_requests_total{route=~\"$route\"}[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (5xx) by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(wovyr_api_requests_total{route=~\"$route\",status=~\"5..\"}[5m])) by (route) / sum(rate(wovyr_api_requests_total{route=~\"$route\"}[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p50 / p95 / p99 (all routes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(wovyr_api_request_duration_seconds_bucket{route=~\"$route\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(wovyr_api_request_duration_seconds_bucket{route=~\"$route\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(wovyr_api_request_duration_seconds_bucket{route=~\"$route\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Unmatched route volume (contract-drift signal)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(wovyr_api_requests_total{route=\"unmatched\"}[5m]))",
          "legendFormat": "unmatched"
        }
      ]
    },
    {
      "id": 5,
      "title": "LLM tokens by model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(wovyr_llm_tokens_total[5m])) by (model, type)",
          "legendFormat": "{{model}} ({{type}})"
        }
      ]
    },
    {
      "id": 6,
      "title": "LLM cost by model ($/hr, projected)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(wovyr_llm_cost_usd_total[1h])) by (model) * 3600",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cache savings ($/hr, projected)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(wovyr_cache_savings_usd_total[1h])) * 3600" }
      ]
    },
    {
      "id": 8,
      "title": "Webhook delivery outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(wovyr_webhook_deliveries_total[5m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Request volume by status class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(wovyr_api_requests_total{route=~\"$route\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "SLO error-budget burn (multi-window 5xx ratio vs 0.5% budget)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "The recorded series from burn-rates.yml (RM-AIM-P3 OBS-302). Fast-burn pages at 7.2% (1h+5m), slow-burn at 3% (6h+30m), trickle tickets at 0.5% (3d+6h).",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "thresholdsStyle": { "mode": "dashed+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "orange", "value": 0.03 },
              { "color": "red", "value": 0.072 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "wovyr:api_error_ratio:rate5m", "legendFormat": "5m" },
        { "expr": "wovyr:api_error_ratio:rate30m", "legendFormat": "30m" },
        { "expr": "wovyr:api_error_ratio:rate1h", "legendFormat": "1h" },
        { "expr": "wovyr:api_error_ratio:rate6h", "legendFormat": "6h" },
        { "expr": "wovyr:api_error_ratio:rate3d", "legendFormat": "3d" }
      ]
    },
    {
      "id": 11,
      "title": "Operability gauges (in-flight / backlogs, OBS-301)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Recomputed at every /metrics scrape from the durable stores (never inc/dec bookkeeping), so values survive restarts and cannot drift.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "wovyr_async_runs_in_flight", "legendFormat": "async runs in flight" },
        { "expr": "wovyr_quota_runs_in_flight", "legendFormat": "quota-admitted runs" },
        { "expr": "wovyr_workflow_executions_active", "legendFormat": "active workflow executions" },
        { "expr": "wovyr_workflow_timers_pending", "legendFormat": "pending workflow timers" },
        { "expr": "wovyr_webhook_outbox_pending", "legendFormat": "webhook outbox pending" },
        { "expr": "wovyr_webhook_dlq_size", "legendFormat": "webhook DLQ size" }
      ]
    }
  ]
}
