{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "dashboard", "start", "--", "--port", "4300"],
      "port": 4300
    },
    {
      "name": "wovyr-server",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-p", "wovyr-cli", "--", "dev", "--addr", "127.0.0.1:8080"],
      "port": 8080
    },
    {
      "name": "checkout-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "examples/ui/checkout-demo", "run", "dev"],
      "port": 5173
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "preview", "--", "--port", "4321"],
      "port": 4321
    }
  ]
}
