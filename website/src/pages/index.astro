      }
    }
  }

  function draw(){
    ctx.clearRect(0,0,W,H);
    var gx=gateX(), acc=COL.accent, blk=COL.block;

    // ---- background: dark = luminous halo · light = a legible scanner track ----
    if(!LIGHT){
      var g=ctx.createRadialGradient(gx,H*0.5,8, gx,H*0.5,Math.max(W,H)*0.55);
      g.addColorStop(0,hexA(acc,0.12)); g.addColorStop(0.45,hexA(acc,0.03));
      g.addColorStop(1,"rgba(0,0,0,0)");
      ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
    } else {
      ctx.fillStyle=hexA("#0D1424",0.05); ctx.fillRect(gx-17,44,34,H-80);
      ctx.fillStyle=hexA(acc,0.10);      ctx.fillRect(gx-17,44,34,H-80);
    }

    // ---- ambient drifting glyph field ----
    setFont(FS); ctx.fillStyle=COL.dim;
    for(var i=0;i<field.length;i++){ var p=field[i];
      p.y+=p.vy; if(p.y<-6){ p.y=H+6; p.x=rnd()*W; }
      ctx.globalAlpha=(LIGHT?p.a*1.5:p.a)*(0.55+0.45*Math.sin(t*0.02+p.tw));
      ctx.fillText(p.ch,p.x,p.y);
    }
    ctx.globalAlpha=1;

    // ---- the scanner: a glyph membrane with a bright sweep travelling it ----
    var sweepY=54+((t*3)%Math.max(40,H-108));
    ctx.save(); if(!LIGHT){ ctx.shadowColor=acc; ctx.shadowBlur=8; } setFont(FS);
    var colg="╎┊┆╎┊", off=Math.floor(t*0.2);
    for(var y=54;y<H-36;y+=LH){
      var s=Math.sin(t*0.05+y*0.06);
      var near=1-Math.min(1,Math.abs(y-sweepY)/44);
      ctx.globalAlpha=(LIGHT?0.5:0.30)+0.35*Math.abs(s)+0.5*near;
      ctx.fillStyle=(near>0.4||s>0.55)?acc:COL.dim;
      ctx.fillText(colg[(y+off)%colg.length], gx-3, y);
    }
    ctx.restore(); ctx.globalAlpha=1;
    // scan reticle riding the sweep
    ctx.save(); ctx.globalAlpha=0.95; ctx.fillStyle=acc;
    if(!LIGHT){ ctx.shadowColor=acc; ctx.shadowBlur=12; }
    setFont(11); ctx.fillText("◂ scan ▸", gx-22, sweepY);
    ctx.restore(); ctx.globalAlpha=1;
    // label
    setFont(11); ctx.fillStyle=acc; ctx.globalAlpha=0.95;
    ctx.fillText("╺ VERIFY", gx-24, 40);
    ctx.fillStyle=COL.dim; ctx.fillText("fail-closed ╸", gx+42, 40);
    ctx.globalAlpha=1;

    // ---- allow ripples along the scanner ----
    for(var ri=ripples.length-1;ri>=0;ri--){ var rp=ripples[ri]; rp.age++;
      var a=1-rp.age/22; if(a<=0){ ripples.splice(ri,1); continue; }
      ctx.globalAlpha=a; ctx.strokeStyle=acc; ctx.lineWidth=LIGHT?2.4:2;
      if(!LIGHT){ ctx.shadowColor=acc; ctx.shadowBlur=10; }
      ctx.beginPath(); ctx.moveTo(gx, rp.y-14-rp.age); ctx.lineTo(gx, rp.y+14+rp.age); ctx.stroke();
      ctx.shadowBlur=0;
    }
    ctx.globalAlpha=1;

    // ---- frames: generative-UI cards being verified node by node ----
    for(var fi=frames.length-1; fi>=0; fi--){ var f=frames[fi];
      if(f.alpha<1) f.alpha=Math.min(1,f.alpha+0.05);
      if(!f.judged && (f.x+cardW()*f.scale*0.5)>=gx){
        f.judged=true;
        var yc=f.y+LH*f.scale*2;
        if(f.kind==="block"){ shatter(f); gateFlash=1; frames.splice(fi,1); continue; }
        ripples.push({y:yc, age:0});
        if(f.kind==="redact"){
          f.flash=1; f.lines[f.bad]=REDACTED_LINE;         // sanitize the offending node
          stamps.push({x:gx+8, y:yc, a:1, vx:0.9, txt:"↺ redacted · 1 node", warn:true});
          var rl=LH*f.scale;
          for(var k=0;k<5;k++) shards.push({x:gx+k*6, y:f.y+f.bad*rl,
            vx:0.2+rnd()*0.9, vy:(rnd()-0.5)*1.6, a:1});
        } else {
          stamps.push({x:gx+8, y:yc, a:1, vx:0.9, txt:"✓ verified · sha256:"+f.hash+"…"});
        }
      }
      f.x+=f.vx; if(f.flash>0) f.flash-=0.06;
      var fs=FS*f.scale, lh=LH*f.scale, passed=f.judged;   // safe + redact both pass
      setFont(fs); ctx.globalAlpha=f.alpha*(passed?0.98:0.85);
      if(passed && !LIGHT){ ctx.shadowColor=acc; ctx.shadowBlur=6; }
      for(var li=0; li<f.lines.length; li++){
        ctx.fillStyle=(f.flash>0 && li===f.bad) ? blk : (passed?acc:COL.dim);
        ctx.fillText(f.lines[li], f.x, f.y+li*lh);
      }
      ctx.shadowBlur=0;
      if(f.x>W+cardW()){ frames.splice(fi,1); }
    }
    ctx.globalAlpha=1;

    // ---- verdict stamps drifting toward the human (audit ledger accumulating) ----
    setFont(11);
    for(var si=stamps.length-1; si>=0; si--){ var st=stamps[si];
      st.x+=st.vx; st.a-=0.005;
      if(st.a<=0||st.x>W+140){ stamps.splice(si,1); continue; }
      ctx.globalAlpha=st.a; ctx.fillStyle=st.warn?COL.a2:acc; ctx.fillText(st.txt, st.x, st.y);
    }
    ctx.globalAlpha=1;

    // ---- shards from blocked / redacted nodes ----
    setFont(FS); ctx.fillStyle=blk;
    for(var di=shards.length-1; di>=0; di--){ var d=shards[di];
      d.x+=d.vx; d.y+=d.vy; d.vy+=0.03; d.a-=0.02;
      if(d.a<=0){ shards.splice(di,1); continue; }
      ctx.globalAlpha=d.a; ctx.fillText(d.ch, d.x, d.y);
    }
    ctx.globalAlpha=1;

    // ---- block flare + label (solid, so it reads on white too) ----
    if(gateFlash>0){
      ctx.save(); ctx.globalAlpha=Math.min(1,gateFlash);
      ctx.strokeStyle=blk; ctx.lineWidth=LIGHT?3:2;
      if(!LIGHT){ ctx.shadowColor=blk; ctx.shadowBlur=12; }
      ctx.beginPath(); ctx.moveTo(gx,48); ctx.lineTo(gx,H-38); ctx.stroke(); ctx.restore();
      setFont(11); ctx.globalAlpha=Math.min(1,gateFlash); ctx.fillStyle=blk;
      ctx.fillText("✕ BLOCKED · unsafe_frame", gx-92, H-22);
      ctx.globalAlpha=1; gateFlash-=0.028;
    }

    // ---- human marker ----
    if(W>660){ setFont(11); ctx.globalAlpha=0.9; ctx.fillStyle=COL.a2;
      ctx.fillText("◇ human", W-98, 58); ctx.fillStyle=COL.dim;
      ctx.fillText("  decides", W-98, 72); ctx.globalAlpha=1; }
  }

  readColors(); resize();
  addEventListener("resize",function(){resize()});
  addEventListener("load",function(){resize()});
  requestAnimationFrame(function(){resize()});
  new MutationObserver(function(){readColors()})
    .observe(root,{attributes:true,attributeFilter:["data-theme"]});

  var last=0;
  function loop(ts){
    if(!running) return;
    var rw=cv.getBoundingClientRect().width;
    if(rw && Math.abs(rw-W)>1) resize();
    if(ts-last>33){ last=ts; t++;
      if(t%40===0 && frames.length<10) spawn();
      draw();
    }
    requestAnimationFrame(loop);
  }

  if(reduce){
    // rich static composition (no motion): cards mid-flight, one passed, one blocked
    var composeStatic=function(){
      resize(); frames.length=0; shards.length=0; stamps.length=0; ripples.length=0;
      for(var s=0;s<5;s++){ spawn(); var f=frames[frames.length-1];
        f.alpha=1; f.x=50+s*((gateX()+120)/5);
        if(f.x+cardW()*f.scale*0.5>=gateX()){
          if(f.kind==="block"){ f.x=gateX()-cardW(); }
          else { f.judged=true; if(f.kind==="redact"){ f.lines[f.bad]=REDACTED_LINE; } }
        } }
      stamps.push({x:gateX()+30,y:120,a:0.9,vx:0,txt:"✓ verified · sha256:1a2f9c…"});
      stamps.push({x:gateX()+120,y:214,a:0.8,vx:0,txt:"↺ redacted · 1 node",warn:true});
      gateFlash=0.9; draw();
    };
    requestAnimationFrame(composeStatic);
    addEventListener("load",composeStatic);
    addEventListener("resize",composeStatic);
  }else{
    for(var pp=0;pp<3;pp++){ spawn(); frames[pp].x=60+pp*160; frames[pp].alpha=1; }
    requestAnimationFrame(loop);
    var heroIO=new IntersectionObserver(function(es){
      var vis=es[0].isIntersecting;
      if(vis&&!running){ running=true; last=0; requestAnimationFrame(loop); }
      running=vis;
    },{threshold:0});
    heroIO.observe(document.getElementById("hero"));
    document.addEventListener("visibilitychange",function(){
      if(document.hidden){ running=false; }
      else{ running=true; last=0; requestAnimationFrame(loop); }
    });
  }
})();
</script>
</body>
</html>
