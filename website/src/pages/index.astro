---
// Wovyr marketing landing — the site root (/). Docs keep their section routes.
// Ported from website/landing/prototypes/wovyr-landing-v1.html (reviewed).

// WEB-303: preload the two self-hosted JetBrains Mono weights actually used
// (400/700 — see src/styles/fonts.css) so the mono display face — this
// page's headline typeface — doesn't wait for CSSOM discovery before the
// browser starts fetching it, reducing the swap-in layout shift `font-
// display: swap` alone doesn't eliminate.
import fontRegularUrl from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import fontBoldUrl from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2?url';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href={fontRegularUrl} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={fontBoldUrl} as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Wovyr — The trust layer for AI-generated interfaces" />
  <meta property="og:description" content="Validate, record, and durably run every interface an AI agent shows a human — on a Rust runtime that survives crashes, restarts, and time." />
  <meta property="og:image" content="/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>
    /* DSY-104/DSY-101: set the theme before first paint to avoid a flash —
       reads the SAME "starlight-theme" key the docs site's
       `ThemeProvider.astro` uses (this page and the docs are the same Astro
       build/origin per astro.config.mjs's `site`, so this is real cross-page
       continuity, not just a matching name). Starlight stores "" for "follow
       system" and "light"/"dark" for an explicit choice.
       DSY-101: data-theme is now ALWAYS set explicitly (falling back to
       matchMedia when no stored preference exists), matching the dashboard's
       ThemeService.apply() pattern exactly — the canonical token file
       (packages/tokens/wovyr-tokens.css) only defines attribute-scoped
       :root[data-theme="light"]/"dark" blocks, not an ambient bare :root
       default, so every surface must set the attribute rather than lean on a
       CSS-only fallback. (The one deliberate exception is the no-JS case:
       with JS disabled data-theme is never set, and the canonical file's
       bare :root block — light values — is what a no-JS visitor sees
       regardless of OS preference. That's an accepted, minor trade-off, not
       a WEB-302 regression: content stays fully visible and legible either
       way, just always in light mode without JS.) */
    try {
      var m = localStorage.getItem("starlight-theme");
      var explicit = (m === "light" || m === "dark") ? m : null;
      var theme = explicit || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    } catch (e) {
      document.documentElement.setAttribute("data-theme", matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    }
  </script>
  <title>Wovyr — The trust layer for AI-generated interfaces</title>
  <meta name="description" content="Wovyr validates, records, and durably runs every interface an AI agent shows a human — built on a Rust agent runtime that survives crashes, restarts, and time." />

<style is:global>
  /* ============================================================= TOKENS
     DSY-101: brand colours, radius, and type stacks are no longer defined
     here — they come from the single canonical source at
     packages/tokens/wovyr-tokens.css (also consumed by the docs site's
     Starlight config and the dashboard's Angular build; see that file's own
     header comment). Only this page's own type SCALE and layout constants
     (--f0.."--f7", --maxw, --pad) stay local — they're a landing-specific
     numeric scale, not a cross-surface brand token. */
  @import "../../../packages/tokens/wovyr-tokens.css";
  /* WEB-303: self-hosted JetBrains Mono — see fonts.css's own header comment. */
  @import "../styles/fonts.css";

  :root{
    --f0:.75rem; --f1:.875rem; --f2:1rem; --f3:1.25rem; --f4:1.6rem;
    --f5:2.1rem; --f6:2.9rem; --f7:4rem;
    --maxw:1200px; --pad:clamp(20px,5vw,64px);
  }

  /* ============================================================= BASE */
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{
    margin:0; background:var(--canvas); color:var(--ink);
    font-family:var(--sans); font-size:var(--f2); line-height:1.6;
    -webkit-font-smoothing:antialiased;
    /* WEB-305: `clip`, not `hidden` — `overflow-x:hidden` here made `body`
       count as an overflow/scroll container in its own right (per the CSS2
       rule that coerces the *other* axis, `overflow-y`, from `visible` to
       `auto` the moment either axis is non-`visible`), which made it a
       candidate "nearest ancestor scroll container" for `.reveal`'s
       `animation-timeline: view()` — but body's own internal scrollTop
       never moves (the real scrolling happens on the viewport via the
       standard body→viewport overflow propagation), so every view-timeline
       animation on the page came up permanently inactive and every
       `.reveal` element sat at the browser default (opacity 1) regardless
       of scroll position. `clip` prevents overflow the same way `hidden`
       did without making body a scroll container at all (`overflow-y`
       stays `visible`, so nothing to coerce), letting `view()` resolve to
       the real viewport as intended. Confirmed empirically: before this
       change every `.reveal` element read `opacity:1` and its animation's
       timeline `currentTime` was `null` at every scroll position; after it,
       elements outside the viewport read `opacity:0` and transition to `1`
       as they scroll into range.
    */
    overflow-x:clip;
  }
  a{color:inherit; text-decoration:none}
  h1,h2,h3{font-family:var(--mono); font-weight:650; letter-spacing:-.02em;
    text-wrap:balance; line-height:1.08; margin:0}
  p{margin:0}
  ::selection{background:var(--accent); color:#fff}
  :focus-visible{outline:2px solid var(--accent); outline-offset:3px; border-radius:4px}

  /* A11Y-204: visually hidden until keyboard-focused, then pinned to the
     top-left corner above everything else. */
  .skip-link{
    position:absolute; top:-100%; left:12px; z-index:100;
    background:var(--surface); color:var(--ink); font-family:var(--mono);
    font-size:var(--f1); padding:10px 16px; border-radius:var(--r-sm);
    border:1px solid var(--accent-line);
  }
  .skip-link:focus{top:12px}

  .wrap{max-width:var(--maxw); margin:0 auto; padding-inline:var(--pad)}
  .eyebrow{font-family:var(--mono); font-size:var(--f0); letter-spacing:.14em;
    text-transform:uppercase; color:var(--ink-dim)}
  .accent{color:var(--accent)}

  /* ============================================================= NAV */
  header.nav{position:sticky; top:0; z-index:50;
    backdrop-filter:blur(10px); background:color-mix(in srgb,var(--canvas) 78%,transparent);
    border-bottom:1px solid transparent; transition:border-color .3s, background .3s}
  header.nav[data-stuck="1"]{border-bottom-color:var(--line)}
  .nav-in{display:flex; align-items:center; gap:24px; height:62px}
  .brand{display:flex; align-items:center; gap:10px; font-family:var(--mono);
    font-weight:650; letter-spacing:.02em; font-size:var(--f2); padding-block:9px}
  .brand svg{width:22px; height:22px; display:block; overflow:visible}
  .mk-win{fill:none; stroke:var(--ink); stroke-width:1.6; stroke-linejoin:round}
  .mk-dot{fill:var(--ink-dim)}
  .mk-scan{stroke:var(--accent); stroke-width:1.7; stroke-linecap:round}
  .mk-node{fill:var(--accent)}
  /* A11Y-208: measured hit areas below the 44×44 guideline (WCAG 2.5.5 AAA /
     2.5.8 AA's 24px minimum) — padding added to the controls' own boxes, not
     the type scale, so visual density is unchanged. `.nav-links a` was 22px
     tall; `padding-block` alone gets it to ~42px, already close to 44. */
  .nav-links{display:flex; gap:22px; margin-left:auto; align-items:center}
  .nav-links a{font-size:var(--f1); color:var(--ink-dim); transition:color .2s;
    display:inline-flex; align-items:center; padding-block:10px}
  .nav-links a:hover{color:var(--ink)}
  .nav-cta{font-family:var(--mono); font-size:var(--f1); padding:10px 16px;
    border:1px solid var(--accent-line); border-radius:var(--r-sm); color:var(--accent)}
  .nav-cta:hover{background:var(--accent-soft)}
  .tgl{display:grid; place-items:center; width:34px; height:34px; cursor:pointer;
    border:1px solid var(--line); border-radius:var(--r-sm); background:var(--surface);
    color:var(--ink-dim); font-family:var(--mono); font-size:var(--f1)}
  .tgl:hover{color:var(--ink); border-color:var(--accent-line)}
  /* Touch viewports get the full 44×44 the guideline prefers — a coarse
     pointer means there's no hover state to rely on for precision. */
  @media (pointer:coarse) {
    .tgl{width:44px; height:44px}
    .nav-cta{padding-block:14px}
  }
  @media(max-width:760px){.nav-links a:not(.nav-cta){display:none}}

  /* ============================================================= HERO */
  #hero{position:relative; min-height:min(92vh,820px); display:flex; align-items:center;
    border-bottom:1px solid var(--line); overflow:hidden}
  #gate{position:absolute; inset:0; width:100%; height:100%; z-index:0}
  .hero-scrim{position:absolute; inset:0; z-index:1; pointer-events:none;
    background:
      linear-gradient(105deg,var(--canvas) 0%,var(--canvas) 34%,
        color-mix(in srgb,var(--canvas) 62%,transparent) 56%,
        color-mix(in srgb,var(--canvas) 20%,transparent) 100%),
      radial-gradient(120% 80% at 12% 30%,color-mix(in srgb,var(--canvas) 55%,transparent),transparent 60%)}
  .hero-in{position:relative; z-index:2; padding-block:clamp(48px,9vh,110px); max-width:660px}
  .hero-tag{display:inline-flex; align-items:center; gap:8px; margin-bottom:22px;
    font-family:var(--mono); font-size:var(--f0); letter-spacing:.1em;
    text-transform:uppercase; color:var(--ink-dim);
    border:1px solid var(--line); border-radius:100px; padding:5px 12px; background:var(--surface)}
  .hero-tag .dot{width:6px; height:6px; border-radius:50%; background:var(--ok);
    box-shadow:0 0 0 3px color-mix(in srgb,var(--ok) 22%,transparent)}
  h1{font-size:clamp(2.1rem,5.6vw,var(--f7)); margin-bottom:20px}
  h1 .b{color:var(--accent)}
  .hero-sub{font-size:clamp(var(--f2),2.2vw,var(--f3)); color:var(--ink-dim);
    max-width:56ch; margin-bottom:30px}
  .cta-row{display:flex; flex-wrap:wrap; gap:12px; align-items:center}
  .btn{font-family:var(--mono); font-size:var(--f1); font-weight:600;
    padding:12px 20px; border-radius:var(--r-sm); cursor:pointer; border:1px solid transparent;
    display:inline-flex; gap:9px; align-items:center; transition:transform .15s, background .2s, border-color .2s}
  .btn:hover{transform:translateY(-1px)}
  /* A11Y-202: --accent-fg (not a hardcoded #fff) — clears AA in both themes,
     see the --accent-fg definitions in :root above. */
  .btn-primary{background:var(--accent); color:var(--accent-fg)}
  .btn-primary:hover{background:color-mix(in srgb,var(--accent) 88%,#fff)}
  .btn-ghost{border-color:var(--line); color:var(--ink); background:var(--surface)}
  .btn-ghost:hover{border-color:var(--accent-line); color:var(--accent)}
  .hero-chip{margin-top:26px; display:inline-flex; align-items:center; gap:10px;
    font-family:var(--mono); font-size:var(--f0); color:var(--ink-dim);
    background:var(--surface-2); border:1px solid var(--line); border-radius:var(--r-sm);
    padding:8px 12px}
  .hero-chip b{color:var(--ok); font-weight:600}

  /* ============================================================= STATUS RAIL */
  .rail{font-family:var(--mono); font-size:var(--f0); color:var(--ink-dim);
    border-bottom:1px solid var(--line); background:var(--surface-2)}
  .rail-in{display:flex; gap:10px 26px; flex-wrap:wrap; padding-block:9px; align-items:center}
  .rail .s{color:var(--ink)}
  .rail .k{color:var(--ok)}
  .rail .sep{color:var(--line)}

  /* ============================================================= SECTION */
  section.band{padding-block:clamp(64px,10vh,120px); border-bottom:1px solid var(--line)}
  .sec-head{max-width:64ch; margin-bottom:44px}
  .sec-head h2{font-size:clamp(var(--f4),3.6vw,var(--f6)); margin:14px 0}
  .sec-head p{color:var(--ink-dim); font-size:var(--f3)}
  /* WEB-305: a CSS scroll-driven animation, replacing the JS
     IntersectionObserver reveal (WEB-302's fix) entirely — no script
     dependency at all, so the "page invisible without JavaScript" failure
     mode this used to patch around structurally cannot recur (there is
     nothing left for a script throw to fail to run). `@supports` means an
     unsupporting browser gets no opacity rule and content is simply visible
     by default — the same graceful degradation `prefers-reduced-motion`
     gets natively from the inner media query, no JS check needed for
     either. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .reveal {
        animation: reveal-in .6s ease both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
      @keyframes reveal-in {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: none; }
      }
    }
  }

  /* consequence chips */
  .chips{display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:14px}
  .chip{background:var(--surface); border:1px solid var(--line); border-radius:var(--r);
    padding:20px}
  .chip .glyph{font-family:var(--mono); color:var(--block); font-size:var(--f3); margin-bottom:10px}
  .chip h3{font-size:var(--f2); margin-bottom:6px; letter-spacing:-.01em}
  .chip p{color:var(--ink-dim); font-size:var(--f1)}

  /* pipeline (numbered — real sequence) */
  .pipe{display:grid; grid-template-columns:repeat(4,1fr); gap:16px}
  @media(max-width:900px){.pipe{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.pipe{grid-template-columns:1fr}}
  .step{position:relative; background:var(--surface); border:1px solid var(--line);
    border-radius:var(--r); padding:22px; transition:border-color .25s, transform .25s}
  .step:hover{border-color:var(--accent-line); transform:translateY(-3px)}
  .step .num{font-family:var(--mono); font-size:var(--f0); color:var(--accent);
    letter-spacing:.14em}
  .step h3{font-size:var(--f2); margin:12px 0 8px}
  .step p{color:var(--ink-dim); font-size:var(--f1)}
  .step pre{margin:14px 0 0; font-family:var(--mono); font-size:.72rem; color:var(--ink-dim);
    background:var(--surface-2); border:1px solid var(--line); border-radius:var(--r-sm);
    padding:10px; overflow-x:auto; line-height:1.5}
  .step pre .p{color:var(--accent)} .step pre .x{color:var(--block)} .step pre .o{color:var(--ok)}

  /* platform grid */
  .grid8{display:grid; grid-template-columns:repeat(4,1fr); gap:14px}
  @media(max-width:900px){.grid8{grid-template-columns:1fr 1fr}}
  @media(max-width:520px){.grid8{grid-template-columns:1fr}}
  .cap{background:var(--surface); border:1px solid var(--line); border-radius:var(--r);
    padding:20px; transition:border-color .25s}
  .cap:hover{border-color:var(--accent-line)}
  .cap .t{font-family:var(--mono); font-size:var(--f1); font-weight:600; margin-bottom:6px}
  .cap .t::before{content:"▸ "; color:var(--accent)}
  .cap p{color:var(--ink-dim); font-size:var(--f0); line-height:1.55}

  /* trust two-col */
  .two{display:grid; grid-template-columns:1.05fr .95fr; gap:40px; align-items:start}
  @media(max-width:860px){.two{grid-template-columns:1fr; gap:28px}}
  .tlist{display:flex; flex-direction:column; gap:16px}
  .trow{display:flex; gap:14px; align-items:flex-start}
  .trow .mk{font-family:var(--mono); color:var(--accent); font-size:var(--f2); margin-top:1px}
  .trow h3{font-size:var(--f2); margin-bottom:4px; letter-spacing:-.01em}
  .trow p{color:var(--ink-dim); font-size:var(--f1)}
  .panel{background:var(--surface-2); border:1px solid var(--line); border-radius:var(--r);
    padding:22px; font-family:var(--mono); font-size:.78rem; line-height:1.7; overflow-x:auto}
  .panel .c{color:var(--ink-dim)} .panel .p{color:var(--accent)} .panel .x{color:var(--block)}
  .panel .o{color:var(--ok)} .panel .h{color:var(--accent-2)}
  .badge-honest{margin-top:22px; display:flex; gap:12px; align-items:flex-start;
    background:var(--surface); border:1px solid var(--accent-line); border-radius:var(--r);
    padding:16px 18px}
  .badge-honest .mk{font-family:var(--mono); color:var(--accent)}
  .badge-honest p{font-size:var(--f1); color:var(--ink-dim)}
  .badge-honest b{color:var(--ink)}

  /* rust spine */
  .spine{font-family:var(--mono); font-size:.74rem; line-height:1.65; color:var(--ink-dim);
    background:var(--surface-2); border:1px solid var(--line); border-radius:var(--r);
    padding:22px; overflow-x:auto; white-space:pre}
  .spine .n{color:var(--accent)} .spine .m{color:var(--accent-2)}
  .stats{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:8px}
  @media(max-width:640px){.stats{grid-template-columns:1fr 1fr}}
  .stat{background:var(--surface); border:1px solid var(--line); border-radius:var(--r); padding:18px}
  .stat .v{font-family:var(--mono); font-size:var(--f4); font-weight:650;
    font-variant-numeric:tabular-nums; letter-spacing:-.02em}
  .stat .l{font-size:var(--f0); color:var(--ink-dim); margin-top:4px}

  /* quickstart */
  .qs{background:var(--surface-2); border:1px solid var(--line); border-radius:var(--r);
    overflow:hidden}
  .qs-bar{display:flex; align-items:center; gap:8px; padding:11px 16px;
    border-bottom:1px solid var(--line); font-family:var(--mono); font-size:var(--f0);
    color:var(--ink-dim)}
  .qs-bar .d{width:10px; height:10px; border-radius:50%}
  .qs-bar .d1{background:#FF5C6A}.qs-bar .d2{background:#FFB84D}.qs-bar .d3{background:#3FBF86}
  .qs-bar .path{margin-left:8px}
  .qs-body{position:relative}
  .qs pre{margin:0; padding:20px; font-family:var(--mono); font-size:var(--f1);
    line-height:1.85; overflow-x:auto}
  .qs .c{color:var(--ink-dim)} .qs .cmd{color:var(--ink)} .qs .fl{color:var(--accent)}
  .qs .out{color:var(--ok)}
  .copy{position:absolute; top:12px; right:12px; font-family:var(--mono); font-size:var(--f0);
    padding:9px 13px; border:1px solid var(--line); border-radius:var(--r-sm);
    background:var(--surface); color:var(--ink-dim); cursor:pointer}
  .copy:hover{color:var(--accent); border-color:var(--accent-line)}
  @media (pointer:coarse) { .copy{padding-block:14px} }
  .qs-links{display:flex; flex-wrap:wrap; gap:10px 22px; margin-top:20px;
    font-family:var(--mono); font-size:var(--f1)}
  .qs-links a{color:var(--ink-dim); display:inline-flex; align-items:center; padding-block:6px}
  .qs-links a:hover{color:var(--accent)}
  .qs-links a::before{content:"→ "; color:var(--accent)}

  /* ecosystem */
  .eco{display:grid; grid-template-columns:repeat(3,1fr); gap:14px}
  @media(max-width:760px){.eco{grid-template-columns:1fr}}
  .eco .cap p{font-size:var(--f1)}

  /* final cta */
  #cta{text-align:center}
  #cta h2{font-size:clamp(var(--f4),4vw,var(--f6)); margin-bottom:16px}
  #cta p{color:var(--ink-dim); font-size:var(--f3); max-width:56ch; margin:0 auto 28px}
  #cta .cta-row{justify-content:center}

  /* footer */
  footer{padding-block:52px 40px; background:var(--surface-2)}
  .foot{display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:30px}
  @media(max-width:760px){.foot{grid-template-columns:1fr 1fr}}
  /* A11Y-205: these are link-group labels, not content headings in the page
   outline (the section H2s already end at H2/H3 depth) — restructured as
   <nav aria-label> below rather than kept as a skipped-to-H4 heading. */
.foot .foot-h{font-family:var(--mono); font-size:var(--f0); letter-spacing:.12em;
    text-transform:uppercase; color:var(--ink-dim); margin:0 0 14px; font-weight:600}
  .foot a{display:block; color:var(--ink-dim); font-size:var(--f1); margin-bottom:2px;
    padding-block:7px}
  .foot a:hover{color:var(--accent)}
  @media (pointer:coarse) { .foot a{padding-block:12px} }
  .foot .brand{margin-bottom:12px}
  .foot .blurb{color:var(--ink-dim); font-size:var(--f1); max-width:32ch}
  .foot-base{border-top:1px solid var(--line); margin-top:40px; padding-top:22px;
    display:flex; flex-wrap:wrap; gap:12px 24px; align-items:center;
    font-family:var(--mono); font-size:var(--f0); color:var(--ink-dim)}
  .foot-base .k{color:var(--ok)}
</style>
</head>
<body>

<!-- A11Y-204: first focusable element on the page — WCAG 2.4.1 (Bypass
     Blocks). Visually hidden until focused (see .skip-link below), jumps
     straight past the nav to <main>. -->
<a class="skip-link" href="#main">Skip to content</a>

<!-- ================================================================ NAV -->
<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a class="brand" href="#top" aria-label="Wovyr home">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="mark"><rect class="mk-win" x="3.5" y="4.5" width="17" height="15" rx="2.6"/><circle class="mk-dot" cx="6.6" cy="8" r="0.9"/><circle class="mk-dot" cx="9.2" cy="8" r="0.9"/><path class="mk-scan" d="M6.4 14H18"/><circle class="mk-node" cx="14.6" cy="14" r="1.7"/></svg>
      wovyr
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#how">How it works</a>
      <a href="#platform">Platform</a>
      <a href="#trust">Trust</a>
      <a href="/00-executive/vision/">Docs</a>
      <a href="https://github.com/punarduttrajput/Wovyr" class="nav-cta">GitHub ↗</a>
      <button class="tgl" id="tgl" aria-label="Toggle color theme" title="Toggle theme">◐</button>
    </nav>
  </div>
