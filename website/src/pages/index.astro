<script is:inline>
(function(){
  /* ---------- theme toggle ----------
     DSY-104: shares "starlight-theme" with the docs site's own theme
     control (same key/encoding `ThemeProvider.astro`/`ThemeSelect.astro`
     use) — toggling here and navigating to a docs page keeps the choice,
     and picking a theme in the docs' own selector (light/dark/auto) is
     respected back here too. Always stores an explicit "light"/"dark" —
     this toggle has no third "auto" state of its own, so it never writes
     Starlight's "" (auto) encoding.
     DSY-101: the head script (see <head>, runs before this) already set
     data-theme unconditionally, so root.getAttribute("data-theme") is
     never null/empty by the time a click can happen — no fallback needed
     here anymore. */
  var root=document.documentElement;
  document.getElementById("tgl").addEventListener("click",function(){
    var cur=root.getAttribute("data-theme");
    var next=cur==="dark"?"light":"dark";
    root.setAttribute("data-theme",next);
    try{localStorage.setItem("starlight-theme",next)}catch(e){}
  });

  /* ---------- nav stuck state ---------- */
  var nav=document.getElementById("nav");
  var sentinel=document.createElement("div");
  document.getElementById("top").before(sentinel);
  new IntersectionObserver(function(es){
    nav.setAttribute("data-stuck", es[0].isIntersecting ? "0":"1");
  }).observe(sentinel);

  /* ---------- copy button ---------- */
  var btn=document.getElementById("copyBtn");
  btn.addEventListener("click",function(){
    var txt=document.getElementById("qsCode").innerText;
    var done=function(){ btn.textContent="copied ✓"; setTimeout(function(){btn.textContent="copy"},1600); };
    if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(txt).then(done,done);}
    else{done();}
  });

  /* ============================================================
     THE TRUST GATE — character-art hero (Canvas 2D), art pass
     Frames = miniature ASCII UI cards flowing toward a luminous
     policy gate. Safe → ripple of light + hash stamp. Unsafe →
     shatter into scattering glyphs. Ambient glyph field for depth.
     ============================================================ */
  var cv=document.getElementById("gate"), ctx=cv.getContext("2d");
  var W=0,H=0,DPR=1, FS=12, LH=13, CW=7.2;
  function css(v){return getComputedStyle(root).getPropertyValue(v).trim();}
  var COL={}, LIGHT=false;
  function luminance(hex){ hex=(hex||"#0A0E18").replace("#","");
    if(hex.length===3){hex=hex[0]+hex[0]+hex[1]+hex[1]+hex[2]+hex[2];}
    var n=parseInt(hex,16); if(isNaN(n)) return 0;
    return (0.2126*((n>>16)&255)+0.7152*((n>>8)&255)+0.0722*(n&255))/255; }
  function readColors(){
    COL.accent=css("--accent"); COL.block=css("--block"); COL.ok=css("--ok");
    COL.dim=css("--ink-dim"); COL.line=css("--line"); COL.a2=css("--accent-2");
    LIGHT=luminance(css("--canvas"))>0.5;
  }
  function hexA(h,a){ h=(h||"#5B7BFF").replace("#","");
    if(h.length===3){h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];}
    var n=parseInt(h,16); if(isNaN(n)) return "rgba(91,123,255,"+a+")";
    return "rgba("+((n>>16)&255)+","+((n>>8)&255)+","+(n&255)+","+a+")"; }
  var FONT='"Cascadia Code","SF Mono","JetBrains Mono",ui-monospace,Menlo,Consolas,monospace';
  function setFont(px){ ctx.font=px+'px '+FONT; }
  function resize(){
    var r=cv.getBoundingClientRect(); DPR=Math.min(devicePixelRatio||1,2);
    W=r.width; H=r.height; cv.width=Math.max(1,W*DPR); cv.height=Math.max(1,H*DPR);
    ctx.setTransform(DPR,0,0,DPR,0,0);
    setFont(FS); ctx.textBaseline="middle"; CW=ctx.measureText("M").width||7.2;
    seedField();
  }

  /* deterministic PRNG so the scene reads the same each load */
  function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);
    t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
  var rnd=mulberry32(20260725);

  /* miniature generative-UI cards the runtime verifies, node by node.
     safe → allow · redact → sanitize one node, frame still passes · block → deny */
  var SAFE=[
    ["┌──────────┐","│ ▤ report │","│ ▦▦▦▦ ▦▦▦ │","│ [ view ] │","└──────────┘"],
    ["┌──────────┐","│ ▤ orders │","│ ▤ 128 new│","│ [ open ] │","└──────────┘"],
    ["┌──────────┐","│ ◹ chart  │","│ ▁▃▅▂▇▄▆▂ │","│ [ zoom ] │","└──────────┘"],
    ["┌──────────┐","│ ▤ inbox  │","│ ▦▦ · ▦▦▦ │","│ [ read ] │","└──────────┘"]
  ];
  var REDACT=[
    {lines:["┌──────────┐","│ ▤ login  │","│ pass●●●● │","│ [submit] │","└──────────┘"], bad:2},
    {lines:["┌──────────┐","│ ▤ pay    │","│ card ●●●●│","│ [ pay  ] │","└──────────┘"], bad:2}
  ];
  var BLOCK=[
    ["┌──────────┐","│ ⚠ eval   │","│ <script> │","│ run code │","└──────────┘"],
    ["┌──────────┐","│ ⚠ embed  │","│ <iframe> │","│ steal ⌗  │","└──────────┘"]
  ];
  var REDACTED_LINE="│ ▓▓▓▓▓▓▓▓ │";

  var frames=[], shards=[], stamps=[], ripples=[], field=[];
  var t=0, running=true, gateFlash=0;
  function gateX(){ return Math.max(W*0.54, 300); }
  function cardW(){ return 12*CW; }

  function seedField(){
    field=[]; var n=Math.min(90,Math.max(24,Math.round((W*H)/15000)));
    var g="·∙˙•:+░.".split("");
    for(var i=0;i<n;i++) field.push({x:rnd()*W, y:rnd()*H,
      ch:g[Math.floor(rnd()*g.length)], a:0.05+rnd()*0.10,
      vy:-(0.04+rnd()*0.14), tw:rnd()*6.28});
  }

  function spawn(){
    var r=rnd(), kind = r<0.55?"safe":(r<0.80?"redact":"block");
    var lines, bad=-1;
    if(kind==="safe"){ lines=SAFE[Math.floor(rnd()*SAFE.length)].slice(); }
    else if(kind==="redact"){ var tp=REDACT[Math.floor(rnd()*REDACT.length)]; lines=tp.lines.slice(); bad=tp.bad; }
    else { lines=BLOCK[Math.floor(rnd()*BLOCK.length)].slice(); }
    var laneN=Math.max(2,Math.floor((H-130)/86));
    var lane=Math.floor(rnd()*laneN);
    frames.push({
      x:-cardW()-20, y:74+lane*((H-130)/laneN)+(rnd()-0.5)*22,
      lines:lines, kind:kind, bad:bad, judged:false, alpha:0, flash:0,
      vx:0.7+rnd()*0.5, scale:0.9+rnd()*0.22,
      hash:Math.floor(rnd()*0xffffff).toString(16).padStart(6,"0")
    });
  }

  function shatter(f){
    var lh=LH*f.scale, cw=CW*f.scale;
    for(var li=0; li<f.lines.length; li++){
      var line=f.lines[li];
      for(var ci=0; ci<line.length; ci++){
        var ch=line[ci]; if(ch===" "||shards.length>240) continue;
        shards.push({x:f.x+ci*cw, y:f.y+li*lh, ch:ch,
