---
// Wovyr marketing landing — the site root (/). Docs keep their section routes.
// Ported from website/landing/prototypes/wovyr-landing-v2.html (reviewed).
//
// Identity: the plate-atlas system — a warp grid the whole page is woven onto,
// numbered plates, indigo and madder dyes, and a wolf's head woven from weft
// threads of light. The figure has no outline and no eyes by design: the weft
// rows stop exactly where the silhouette stops, so the shape is read from where
// the threads end. See website/landing/DESIGN-system.md.
//
// Preload the three faces actually used above the fold (Archivo variable, and
// IBM Plex Mono 400/500) so the display face isn't waiting on CSSOM discovery —
// the same reasoning as the retired page's JetBrains Mono preload.
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import monoRegularUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import monoMediumUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';

const CONTACT = 'contact@wovyr.com';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={monoRegularUrl} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={monoMediumUrl} as="font" type="font/woff2" crossorigin />
  <title>Wovyr — The trust layer for AI-generated interfaces</title>
  <meta name="description" content="Your agents compose screens at runtime, reviewed by nobody. Wovyr checks every thread against policy, cuts the ones that fail, records what was shown, and holds the work until a human decides." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Wovyr — The trust layer for AI-generated interfaces" />
  <meta property="og:description" content="Wovyr checks every interface an AI agent generates against policy, cuts what fails, records what was shown, and holds the work until a human decides — on a Rust runtime that survives crashes and restarts." />
  <meta property="og:image" content="/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>
    /* Set the theme before first paint to avoid a flash, reading the SAME
       "starlight-theme" key the docs site's ThemeProvider.astro uses — this
       page and the docs are one Astro build/origin, so a choice made in
       either surface carries to the other. Starlight stores "" for "follow
       system" and "light"/"dark" for an explicit choice; data-theme is
       always set explicitly here (falling back to matchMedia) because the
       palette below only defines attribute-scoped light/dark blocks.

       The one deliberate exception is the no-JS case: with JS disabled
       data-theme is never set, and the bare :root block — light values — is
       what a visitor sees regardless of OS preference. Content stays fully
       legible either way. */
    try {
      var m = localStorage.getItem("starlight-theme");
      var explicit = (m === "light" || m === "dark") ? m : null;
      var theme = explicit || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    } catch (e) {
      document.documentElement.setAttribute("data-theme", matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    }
  </script>

<style is:global>
  @import "../styles/landing-fonts.css";

  /* ================================================================ TOKENS
     Scoped to this page. The canonical cross-surface token file
     (packages/tokens/wovyr-tokens.css) still carries the retired cobalt
     system consumed by the docs and the dashboard — migrating those two
     surfaces is a separate piece of work, flagged in DESIGN-system.md §8.
     Indigo and madder are the two classical dyes: indigo = a sound thread,
     madder = a thread policy cut. Madder is semantic only, never decorative. */
  :root{
    --paper:#DEE3E7; --paper-2:#EBEEF0; --sunk:#D2D9DE;
    --ink:#0E141A; --ink-2:#53616D; --warp:#C3CCD3; --warp-2:#AEB9C2;
    --indigo:#27386B; --indigo-soft:#8FA0CE; --madder:#A63A26;
    --ui:'Archivo Variable',system-ui,-apple-system,'Segoe UI',sans-serif;
    --mono:'IBM Plex Mono',ui-monospace,'Cascadia Mono',Consolas,monospace;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --paper:#0C1115; --paper-2:#131920; --sunk:#080B0E;
      --ink:#E7EBEF; --ink-2:#8B98A3; --warp:#1D252C; --warp-2:#2C3641;
      --indigo:#8AA2E8; --indigo-soft:#3C4C7E; --madder:#E5735C;
    }
  }
  :root[data-theme="light"]{
    --paper:#DEE3E7; --paper-2:#EBEEF0; --sunk:#D2D9DE;
    --ink:#0E141A; --ink-2:#53616D; --warp:#C3CCD3; --warp-2:#AEB9C2;
    --indigo:#27386B; --indigo-soft:#8FA0CE; --madder:#A63A26;
  }
  :root[data-theme="dark"]{
    --paper:#0C1115; --paper-2:#131920; --sunk:#080B0E;
    --ink:#E7EBEF; --ink-2:#8B98A3; --warp:#1D252C; --warp-2:#2C3641;
    --indigo:#8AA2E8; --indigo-soft:#3C4C7E; --madder:#E5735C;
  }

  /* ================================================================== BASE */
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{
    margin:0; background:var(--paper); color:var(--ink);
    font-family:var(--ui); font-size:16px; line-height:1.65;
    -webkit-font-smoothing:antialiased;
    /* `clip`, not `hidden` — `overflow-x:hidden` here would make body a scroll
       container in its own right (CSS2 coerces the other axis away from
       `visible`), which breaks viewport-relative scroll machinery. */
    overflow-x:clip;
    position:relative;
  }
  /* the warp — vertical threads the whole page is woven onto */
  body::before{
    content:""; position:absolute; inset:0; z-index:0; pointer-events:none;
    background:repeating-linear-gradient(90deg,var(--warp) 0 1px,transparent 1px 46px);
    opacity:.5;
  }
  body > *{position:relative; z-index:1}
  a{color:inherit; text-decoration:none}
  p{margin:0}
  h1,h2,h3{margin:0; font-family:var(--ui); font-weight:700;
    line-height:1.06; letter-spacing:-.021em; text-wrap:balance}
  ::selection{background:var(--indigo); color:var(--paper)}
  :focus-visible{outline:2px solid var(--indigo); outline-offset:3px}

  .skip-link{
    position:absolute; top:-100%; left:12px; z-index:100;
    background:var(--paper-2); color:var(--ink); font-family:var(--mono);
    font-size:13px; padding:10px 16px; border:1px solid var(--indigo);
  }
  .skip-link:focus{top:12px}

  .w{max-width:1160px; margin:0 auto; padding-inline:clamp(20px,5vw,54px)}
  .ann{font-family:var(--mono); font-size:11px; letter-spacing:.13em;
    text-transform:uppercase; color:var(--ink-2); font-weight:500}
  .tnum{font-variant-numeric:tabular-nums}
  .sel{border-left:1px dashed var(--warp-2); padding-left:clamp(16px,2.5vw,30px)}

  /* =================================================================== NAV */
  .nb{position:sticky; top:0; z-index:40;
    background:color-mix(in srgb,var(--paper) 90%,transparent);
    backdrop-filter:blur(7px); border-bottom:1px solid var(--warp)}
  .nb-in{display:flex; align-items:center; gap:26px; height:62px}
  .bd{display:flex; align-items:center; gap:10px; font-weight:700; font-size:19px;
    letter-spacing:-.01em}
  .bd svg{width:24px; height:24px; color:var(--indigo); display:block}
  .nl{margin-left:auto; display:flex; gap:24px; align-items:center}
  .nl a{font-family:var(--mono); font-size:11px; letter-spacing:.12em;
    text-transform:uppercase; color:var(--ink-2); padding-block:12px; transition:color .18s}
  .nl a:hover{color:var(--indigo)}
  .tg{width:38px; height:38px; display:grid; place-items:center; cursor:pointer;
    border:1px solid var(--warp-2); background:none; color:var(--ink-2); font-size:12px}
  .tg:hover{color:var(--indigo); border-color:var(--indigo)}
  @media(pointer:coarse){ .tg{width:44px; height:44px} }
  @media(max-width:820px){ .nl a:not(.keep){display:none} }

  /* ================================================================== HERO */
  .hero{min-height:min(90svh,900px); display:flex; align-items:center;
    padding-block:clamp(38px,6vw,70px); border-bottom:1px solid var(--warp)}
  .hero-g{display:grid; grid-template-columns:minmax(0,1.18fr) minmax(0,.82fr);
    gap:clamp(28px,5vw,70px); align-items:center; width:100%}
  @media(max-width:900px){ .hero-g{grid-template-columns:1fr} }
  .plate-no{display:flex; align-items:center; gap:12px; margin-bottom:24px}
  .plate-no::after{content:""; flex:1; height:1px; background:var(--warp-2)}
  .hero h1{font-size:clamp(2.2rem,5vw,3.7rem); margin-bottom:22px}
  .hero h1 span{color:var(--indigo)}
  .hero p.sub{max-width:50ch; color:var(--ink-2);
    font-size:clamp(1rem,1.35vw,1.12rem); margin-bottom:30px}
  .acts{display:flex; gap:12px; flex-wrap:wrap}
  .b{font-family:var(--mono); font-size:12px; font-weight:500; letter-spacing:.12em;
    text-transform:uppercase; padding:14px 22px; border:1px solid var(--indigo);
    transition:background .18s,color .18s}
  .b-fill{background:var(--indigo); color:var(--paper)}
  .b-fill:hover{background:transparent; color:var(--indigo)}
  .b-line{color:var(--ink); border-color:var(--warp-2)}
  .b-line:hover{border-color:var(--ink)}

  .figure{position:relative}
  .figure canvas{display:block; width:100%; aspect-ratio:1/1; height:auto}
  .fig-cap{display:flex; gap:16px; flex-wrap:wrap; margin-top:6px;
    border-top:1px solid var(--warp-2); padding-top:12px}

  /* ================================================================ PLATES */
  .plate{padding-block:clamp(52px,8vw,96px); border-bottom:1px solid var(--warp)}
  .p-head{display:flex; align-items:center; gap:12px; margin-bottom:clamp(24px,4vw,40px)}
  .p-head::after{content:""; flex:1; height:1px; background:var(--warp-2)}
  .plate h2{font-size:clamp(1.8rem,3.4vw,2.7rem); max-width:20ch}
  .plate h2 span{color:var(--indigo)}
  .lede{max-width:62ch; color:var(--ink-2); margin-top:18px}

  .cols{display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr);
    gap:clamp(28px,5vw,68px); align-items:start}
  @media(max-width:880px){ .cols{grid-template-columns:1fr} }

  .notes{display:flex; flex-direction:column}
  .notes > div{padding:19px 0; border-top:1px solid var(--warp)}
  .notes h3{font-size:1.08rem; margin-bottom:6px}
  .notes p{color:var(--ink-2); font-size:.94rem}

  /* A real ordered sequence, so it is numbered. Every segment is indigo —
     madder is reserved for a thread that was actually cut. */
  .pass{display:grid; grid-template-columns:repeat(4,1fr); margin-top:clamp(28px,4vw,46px)}
  .pass > div{padding:22px clamp(14px,2vw,26px) 4px 0; border-top:2px solid var(--indigo)}
  @media(max-width:900px){ .pass{grid-template-columns:repeat(2,1fr)} }
  @media(max-width:560px){ .pass{grid-template-columns:1fr} }
  .pass .k{margin-bottom:10px}
  .pass h3{font-size:1.14rem; margin-bottom:8px}
  .pass p{color:var(--ink-2); font-size:.92rem}

  .cloth{background:var(--paper-2); border:1px solid var(--warp-2); padding:20px}
  .cloth svg{display:block; width:100%; height:auto}
  .cloth-legend{display:flex; gap:20px; flex-wrap:wrap; margin-top:14px}
  .dot{display:inline-flex; align-items:center; gap:7px}
  .dot i{width:16px; height:2px; display:block}

  .reg{margin-top:clamp(26px,4vw,44px); border-top:1px solid var(--warp-2)}
  .reg > div{display:grid; grid-template-columns:44px minmax(0,.62fr) minmax(0,2fr);
    gap:clamp(10px,2.5vw,26px); padding:17px 0; border-bottom:1px solid var(--warp);
    align-items:baseline}
  .reg .no{font-family:var(--mono); font-size:11.5px; color:var(--ink-2)}
  .reg .nm{font-weight:600; font-size:1.02rem}
  .reg .ds{color:var(--ink-2); font-size:.93rem}
  @media(max-width:680px){ .reg > div{grid-template-columns:36px 1fr} .reg .ds{grid-column:2} }

  .candor{margin-top:22px; background:var(--paper-2); border-left:3px solid var(--madder);
    padding:16px 18px; color:var(--ink-2); font-size:.93rem}
  .candor b{color:var(--ink)}

  /* Colophon — a spec sheet of where the project actually lives. Two ruled
     columns, label left, value right; the value column is mono because every
     entry is a literal you can paste (a package name, a licence id, a repo). */
  .colo{border-top:1px solid var(--warp-2)}
  .colo > div{display:grid; grid-template-columns:minmax(0,.5fr) minmax(0,1fr);
    gap:clamp(10px,2.5vw,26px); padding:13px 0; border-bottom:1px solid var(--warp);
    align-items:baseline}
  .colo dt{font-family:var(--mono); font-size:10.5px; letter-spacing:.13em;
    text-transform:uppercase; color:var(--ink-2); margin:0}
  .colo dd{margin:0; font-family:var(--mono); font-size:.9rem; color:var(--ink);
    overflow-wrap:anywhere}
  .colo dd a{color:var(--indigo); border-bottom:1px solid var(--warp-2)}
  .colo dd a:hover{border-color:var(--indigo)}
  .colo dd .muted{color:var(--ink-2)}

  .counts{display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
    gap:1px; background:var(--warp-2); border:1px solid var(--warp-2);
    margin-top:clamp(22px,4vw,38px)}
  .counts div{background:var(--paper); padding:22px 18px}
  .counts .v{font-size:clamp(1.9rem,3.6vw,2.7rem); font-weight:700; line-height:1;
    letter-spacing:-.03em}
  .counts .k{margin-top:7px}

  .tm{border:1px solid var(--warp-2); background:var(--sunk); margin-top:clamp(24px,4vw,40px)}
  .tm-top{display:flex; align-items:center; gap:12px; padding:12px 16px;
    border-bottom:1px solid var(--warp-2)}
  .tm-top .ann{margin-right:auto}
  .cpy{font-family:var(--mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase;
    background:none; border:1px solid var(--warp-2); color:var(--ink-2);
    padding:6px 12px; cursor:pointer}
  .cpy:hover{color:var(--indigo); border-color:var(--indigo)}
  .tm pre{margin:0; padding:20px 16px; overflow-x:auto}
  .tm code{font-family:var(--mono); font-size:13px; line-height:1.95; display:block;
    white-space:pre}
  .tm .c{color:var(--ink-2)}
  .tm .o{color:var(--indigo); font-weight:500}
  .next{display:flex; flex-wrap:wrap; gap:20px; margin-top:20px}
  .next a{font-family:var(--mono); font-size:11.5px; letter-spacing:.11em;
    text-transform:uppercase; color:var(--ink-2); border-bottom:1px solid var(--warp-2);
    padding-bottom:3px}
  .next a:hover{color:var(--indigo); border-color:var(--indigo)}

  /* ================================================================ FOOTER */
  .ft{padding-block:42px 30px}
  .ft-in{display:flex; flex-wrap:wrap; gap:32px}
  .ft-in nav{display:flex; flex-direction:column; gap:9px}
  .ft-in nav a{font-size:.9rem; color:var(--ink-2)}
  .ft-in nav a:hover{color:var(--ink)}
  .ft-in nav .ann{margin-bottom:4px}
  .ft-mail{display:inline-block; margin-top:14px; font-family:var(--mono);
    font-size:.86rem; color:var(--indigo); border-bottom:1px solid var(--warp-2);
    padding-bottom:2px}
  .ft-mail:hover{border-color:var(--indigo)}
  .ft-base{margin-top:34px; padding-top:16px; border-top:1px solid var(--warp);
    display:flex; flex-wrap:wrap; gap:16px}

  .rv{opacity:0; transform:translateY(12px); transition:opacity .6s ease,transform .6s ease}
  .rv.in{opacity:1; transform:none}
  @media (prefers-reduced-motion: reduce){ .rv{opacity:1; transform:none; transition:none} }
</style>

<!--
  WEB-302: `.rv` starts at opacity:0 and is only revealed by the
  IntersectionObserver below adding `.in`. Without this fallback, a visitor with
  JavaScript disabled (or a scraper, or a crawler that doesn't execute JS) sees
  the hero and nothing else — every section below it stays permanently
  invisible. Progressive enhancement: the animation is the enhancement, the
  content is not.
-->
<noscript><style>
  .rv{opacity:1 !important; transform:none !important; transition:none !important}
</style></noscript>
</head>

<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="nb"><div class="w nb-in">
  <a class="bd" href="#top" aria-label="Wovyr home">
    <svg viewBox="0 0 100 100" aria-hidden="true"><path fill="currentColor" d="M50 26 L34 30 L18 6 L22 38 L12 52 L22 60 L16 72 L30 74 L36 64 L40 86 L44 94 L50 97 L56 94 L60 86 L64 64 L70 74 L84 72 L78 60 L88 52 L78 38 L82 6 L66 30 Z"/></svg>
    wovyr</a>
  <nav class="nl" aria-label="Primary">
    <a href="#shuttle">The shuttle</a><a href="#loom">The loom</a>
    <a href="#open">Open source</a><a href="/00-executive/vision/">Docs</a>
    <a href="https://github.com/punarduttrajput/wovyr">GitHub</a>
    <a class="keep" href="#start">Start</a>
  </nav>
  <button class="tg" id="tg" aria-label="Switch colour theme">◐</button>
</div></header>

<main id="main">
<section class="hero" id="top"><div class="w">
  <div class="hero-g">
    <div class="sel">
      <div class="plate-no"><span class="ann">Plate 01 — Wovyr</span></div>
      <h1>Something is weaving your interfaces. <span>Something should be checking every thread.</span></h1>
      <p class="sub">Your agents compose screens at runtime — thread by thread, for one
        person, reviewed by nobody. Wovyr is the loom: it checks each thread against
        policy, cuts the ones that fail before they reach the web, keeps a record you
        can prove, and holds the work until a human decides.</p>
      <div class="acts">
        <a class="b b-fill" href="#start">Run it in 5 minutes</a>
        <a class="b b-line" href="#shuttle">See the pass</a>
      </div>
    </div>
    <div class="figure">
      <canvas id="fig" aria-hidden="true"></canvas>
      <div class="fig-cap">
        <span class="ann tnum">Fig. 1 — <span id="wcount">0</span> weft</span>
        <span class="ann tnum" style="color:var(--madder)"><span id="ccount">0</span> <span id="clabel">threads cut</span></span>
      </div>
    </div>
  </div>
</div></section>

<section class="plate" id="cloth" aria-labelledby="cloth-h"><div class="w rv">
  <div class="p-head"><span class="ann">Plate 02 — Why the cloth needs checking</span></div>
  <div class="cols">
    <div>
      <h2 id="cloth-h">An interface used to be something a person <span>signed off.</span></h2>
      <p class="lede">Now it is produced in the moment, by a model, for a single user — and
        the assumptions the web was built on quietly stopped holding. Nobody reviewed this
        screen. Nobody can say later what it showed.</p>
    </div>
    <div class="notes">
      <div><h3>A convincing screen is a convincing attack</h3>
        <p>A model can weave a flawless payment form. Being generated does not make it yours.</p></div>
      <div><h3>Injection arrives as interface</h3>
        <p>Poisoned context need not change the answer. It only has to change the button.</p></div>
      <div><h3>You cannot audit what nobody kept</h3>
        <p>When a user says "it told me to approve it", you need the exact frame they saw.</p></div>
    </div>
  </div>
</div></section>

<section class="plate" id="shuttle" aria-labelledby="shuttle-h"><div class="w rv">
  <div class="p-head"><span class="ann">Plate 03 — The pass</span></div>
  <h2 id="shuttle-h">One pass of the shuttle, <span>four checks.</span></h2>
  <p class="lede">The same sequence for every frame — no fast path, no trusted caller, no
    exception for your own first-party agents.</p>
  <div class="pass">
    <div><div class="k ann tnum">01 · Emit</div><h3>Threads chosen</h3>
      <p>The agent composes from a declared vocabulary. There is no node that can carry raw HTML or a script.</p></div>
    <div><div class="k ann tnum">02 · Examine</div><h3>Shed inspected</h3>
      <p>Policy runs before anything renders. Unknown node, sensitive input, deceptive label — denied by default.</p></div>
    <div><div class="k ann tnum">03 · Record</div><h3>Selvedge marked</h3>
      <p>Frame and verdict enter a keyed hash chain, so an interior edit or a cut tail both show.</p></div>
    <div><div class="k ann tnum">04 · Decide</div><h3>Held on the beam</h3>
      <p>The work waits for a human. The run is event-sourced, so their answer outlives the process.</p></div>
  </div>
</div></section>

<section class="plate" aria-labelledby="cut-h"><div class="w rv">
  <div class="p-head"><span class="ann">Plate 04 — A thread cut</span></div>
  <div class="cols">
    <div>
      <h2 id="cut-h">Fail-closed means the thread <span>does not reach the web.</span></h2>
      <p class="lede">A password field inside a generated frame is not a mistake to log and
        move past. The policy cuts it, the cut is recorded, and the human never sees the
        frame at all.</p>
      <div class="notes" style="margin-top:22px">
        <div><h3>Fail-closed policy</h3><p>Anything the policy does not recognise is denied. Silence is never consent.</p></div>
        <div><h3>A vocabulary, not a canvas</h3><p>Agents pick declared components. Nothing in the set can carry a script.</p></div>
        <div><h3>Tamper-evident record</h3><p>A keyed HMAC chain with a head anchor — rewriting it needs a key you hold offline.</p></div>
        <div><h3>Guards on by default</h3><p>SSRF and egress guards, DNS pinning, and a sandbox floor that refuses to run unconfined in silence.</p></div>
      </div>
    </div>
    <div>
      <div class="cloth">
        <svg viewBox="0 0 200 120" role="img" aria-label="A woven band with one thread cut and marked"><g id="band"></g></svg>
        <div class="cloth-legend">
          <span class="dot ann"><i style="background:var(--indigo)"></i>passed policy</span>
          <span class="dot ann"><i style="background:var(--madder)"></i>cut — sensitive_input</span>
        </div>
      </div>
      <div class="candor"><b>Shipped and roadmap are marked plainly.</b> Wovyr ships today as a
        single-node appliance; the distributed scheduler is tested library code, not yet in
        the binary. For a security product, candour is the feature.</div>
    </div>
  </div>
</div></section>

<section class="plate" id="loom" aria-labelledby="loom-h"><div class="w rv">
  <div class="p-head"><span class="ann">Plate 05 — The loom</span></div>
  <h2 id="loom-h">Eight engines, <span>one Rust binary.</span></h2>
  <p class="lede">The trust layer is not a wrapper around someone else's stack. It runs on a
    complete agent operating system — and you deploy all of it as a single file.</p>
  <div class="reg">
    <div><span class="no tnum">01</span><span class="nm">Agent runtime</span><span class="ds">The model→tool→model loop, with context compaction and step budgets that hold.</span></div>
    <div><span class="no tnum">02</span><span class="nm">Workflow engine</span><span class="ds">Event-sourced DAGs that resume exactly where they crashed — including mid-approval.</span></div>
    <div><span class="no tnum">03</span><span class="nm">Tool runtime</span><span class="ds">Sandboxed execution across native, container, gVisor and microVM. Fail-closed.</span></div>
    <div><span class="no tnum">04</span><span class="nm">Memory engine</span><span class="ds">Hybrid vector and keyword retrieval, ranked by relevance, recency and importance.</span></div>
    <div><span class="no tnum">05</span><span class="nm">LLM gateway</span><span class="ds">OpenAI, Anthropic or a local model, with failover, caching and circuit breakers.</span></div>
    <div><span class="no tnum">06</span><span class="nm">Plugin framework</span><span class="ds">Signed, sandboxed WASM extensions and a governed marketplace with real review.</span></div>
    <div><span class="no tnum">07</span><span class="nm">Workflow studio</span><span class="ds">A dashboard to compose, run and watch agents and workflows as they execute.</span></div>
    <div><span class="no tnum">08</span><span class="nm">Tenancy &amp; security</span><span class="ds">Multi-tenancy, RBAC, KMS envelope encryption, quotas and the audit chain.</span></div>
  </div>
  <div class="counts">
    <div><div class="v tnum">22</div><div class="k ann">crates</div></div>
    <div><div class="v tnum">2024</div><div class="k ann">Rust edition</div></div>
    <div><div class="v tnum">1,143</div><div class="k ann">tests, 0 failing</div></div>
    <div><div class="v tnum">0</div><div class="k ann">ambient clocks</div></div>
  </div>
</div></section>

<section class="plate" id="start" aria-labelledby="start-h"><div class="w rv">
  <div class="p-head"><span class="ann">Plate 06 — Threading up</span></div>
  <h2 id="start-h">Running in five minutes, <span>fully offline.</span></h2>
  <p class="lede">No API key. A deterministic mock provider answers, so you can watch the
    whole loop before wiring a real model to it.</p>
  <div class="tm">
    <div class="tm-top"><span class="ann">bash — first agent run</span>
      <button class="cpy" id="copy">Copy</button></div>
    <pre><code id="qs"><span class="c"># install the CLI from crates.io</span>
cargo install wovyr-cli

<span class="c"># start the all-in-one local server — no API key, no Docker</span>
WOVYR_ALLOW_ANONYMOUS=1 wovyr dev
<span class="o">→ listening on http://127.0.0.1:8080</span>

<span class="c"># run an agent. A deterministic mock provider answers, so this needs
# no key — the example manifests ship in the repo:</span>
git clone https://github.com/punarduttrajput/wovyr &amp;&amp; cd wovyr
wovyr agents run --local -f examples/agents/hello.yaml \
  --input '&#123;"message":"Hi"&#125;' --stream</code></pre>
