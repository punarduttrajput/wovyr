<script is:inline>
(function(){
  var NS="http://www.w3.org/2000/svg";
  var reduce=matchMedia("(prefers-reduced-motion: reduce)").matches;
  var root=document.documentElement;
  var WOLF="M50 26 L34 30 L18 6 L22 38 L12 52 L22 60 L16 72 L30 74 L36 64 L40 86 L44 94 L50 97 L56 94 L60 86 L64 64 L70 74 L84 72 L78 60 L88 52 L78 38 L82 6 L66 30 Z";

  function cssv(n,f){ return getComputedStyle(root).getPropertyValue(n).trim()||f; }
  function rgba(hex,a){
    hex=(hex||"#27386B").replace("#","");
    if(hex.length===3) hex=hex[0]+hex[0]+hex[1]+hex[1]+hex[2]+hex[2];
    var n=parseInt(hex,16); if(isNaN(n)) return "rgba(39,56,107,"+a+")";
    return "rgba("+((n>>16)&255)+","+((n>>8)&255)+","+(n&255)+","+a+")";
  }
  function isLight(){
    var h=cssv("--paper","#DEE3E7").replace("#","");
    if(h.length===3) h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
    var n=parseInt(h,16); if(isNaN(n)) return true;
    return (0.2126*((n>>16)&255)+0.7152*((n>>8)&255)+0.0722*(n&255))/255>0.5;
  }

  /* ================= THE WOVEN FIGURE =================
     Weft rows are scanned against the silhouette and simply stop where it
     stops — no outline is drawn and there are no eyes. The head is read from
     where the threads end. Rows settle top to bottom, the way cloth comes off
     a loom; then policy cuts one thread every few seconds and it re-weaves,
     and the counter under the figure is the real count. */
  function Loom(canvas, opts){
    var ctx=canvas.getContext("2d");
    var off=document.createElement("canvas"); off.width=off.height=100;
    var octx=off.getContext("2d"), P=new Path2D(WOLF);
    var rows=[], W=0,H=0,DPR=1, sc=1, ox=0, oy=0, t0=0, raf=0;
    var cut=null, cuts=0, nextCut=opts.firstCut, seed=opts.seed||7;
    function rnd(){ seed=(seed*1664525+1013904223)>>>0; return seed/4294967296; }

    function scan(){
      rows=[];
      for(var y=2;y<99;y+=opts.pitch){
        var spans=[], inside=false, start=0;
        for(var x=0;x<=100;x+=0.4){
          var hit=octx.isPointInPath(P,x,y);
          if(hit && !inside){ inside=true; start=x; }
          /* 0.5, not a full dot-pitch: the ear tips are only ~1 unit wide at
             the top, and dropping them blunts the two shapes the head is read by. */
          else if(!hit && inside){ inside=false; if(x-start>0.5) spans.push([start,x]); }
        }
        if(inside && 100-start>0.5) spans.push([start,100]);
        if(!spans.length) continue;
        var runs=[];
        for(var s=0;s<spans.length;s++){
          var a=spans[s][0], b=spans[s][1], run=[];
          for(var x2=a; x2<=b+0.001; x2+=opts.dot){
            run.push({ tx:Math.min(x2,b), ty:y,
              sx:Math.min(x2,b)+(rnd()-.5)*70, sy:y+(rnd()-.5)*70, ph:rnd()*6.283 });
          }
          /* a one-point run is still a thread end — keep it, it draws as a dot */
          if(run.length) runs.push(run);
        }
        if(runs.length) rows.push({ y:y, runs:runs, i:rows.length });
      }
      var el=document.getElementById("wcount");
      if(el && opts.report) el.textContent=rows.length;
    }

    function size(){
      var r=canvas.getBoundingClientRect();
      DPR=Math.min(devicePixelRatio||1,2);
      W=r.width||1; H=r.height||1;
      canvas.width=Math.max(1,W*DPR); canvas.height=Math.max(1,H*DPR);
      ctx.setTransform(DPR,0,0,DPR,0,0);
      sc=Math.min(W,H)/104; ox=(W-100*sc)/2; oy=(H-100*sc)/2;
    }
    function ease(p){ return 1-Math.pow(1-p,3); }

    function render(now){
      if(!t0) t0=now;
      var el=(now-t0)/1000, light=isLight();
      var indigo=cssv("--indigo","#27386B"), madder=cssv("--madder","#A63A26");
      ctx.clearRect(0,0,W,H); ctx.lineCap="round";

      if(opts.cuts && el>nextCut && !cut && rows.length){
        /* cut a row that crosses the head in one unbroken run — on a row
           already split by the cheek notches the break reads as dashes
           rather than as one thread being severed. */
        var solid=[];
        for(var s2=0;s2<rows.length;s2++)
          if(rows[s2].runs.length===1 && rows[s2].runs[0].length>6) solid.push(s2);
        var ri=solid.length ? solid[Math.floor(rnd()*solid.length)]
                            : Math.floor(rnd()*rows.length);
        cut={ row:ri, at:el }; cuts++;
        var cc=document.getElementById("ccount"); if(cc) cc.textContent=cuts;
        var cl=document.getElementById("clabel");
        if(cl) cl.textContent=cuts===1?"thread cut":"threads cut";
        nextCut=el+3.6+rnd()*3.2;
      }
      if(cut && el-cut.at>1.5) cut=null;

      for(var i=0;i<rows.length;i++){
        var row=rows[i];
        var p=Math.max(0, Math.min(1, (el-opts.stagger*i)/0.85));
        var conv=ease(p);
        if(conv<=0) continue;

        var isCut = cut && cut.row===i;
        var cutT = isCut ? Math.min(1,(el-cut.at)/0.35) : 0;
        var heal = isCut ? Math.max(0,(el-cut.at-1.0)/0.5) : 0;
        var open = isCut ? Math.max(0, cutT-heal) : 0;
        var col = isCut ? madder : indigo;
        var breath = Math.sin(el*0.7+i*0.35)*0.30*conv;

        for(var r2=0;r2<row.runs.length;r2++){
          var run=row.runs[r2], mid=(run.length-1)/2;
          for(var k=0;k<run.length;k++){
            var q=run[k];
            var push = open>0 ? (k<mid ? -open*4.5 : open*4.5) : 0;
            q.x = ox + (q.sx+(q.tx-q.sx)*conv + push*conv)*sc;
            q.y = oy + (q.sy+(q.ty-q.sy)*conv + breath)*sc;
          }
          ctx.strokeStyle=rgba(col,(light?0.55:0.50)*conv);
          ctx.lineWidth=Math.max(.6, sc*(row.y>42&&row.y<60?1.05:0.75));
          if(!light){ ctx.shadowColor=col; ctx.shadowBlur=6*conv; }
          ctx.beginPath();
          for(var k2=0;k2<run.length;k2++){
            var pt=run[k2];
            if(open>0 && Math.abs(k2-mid)<open*1.4){ ctx.moveTo(pt.x,pt.y); continue; }
            k2?ctx.lineTo(pt.x,pt.y):ctx.moveTo(pt.x,pt.y);
          }
          ctx.stroke();
          /* The light on the thread. No per-dot glow: the stroke above already
             carries it, and a shadowBlur on every dot was the dominant frame
             cost (~1,000 shadowed fills) with nothing visible to show for it. */
          ctx.shadowBlur=0;
          for(var k3=0;k3<run.length;k3++){
            var pp=run[k3];
            var tw=0.55+0.45*Math.sin(el*1.5+pp.ph);
            ctx.fillStyle=rgba(col,(light?0.85:0.72)*conv*(0.55+0.45*tw));
            ctx.beginPath(); ctx.arc(pp.x,pp.y,Math.max(.5,sc*0.34),0,6.283); ctx.fill();
          }
        }
      }
      raf=requestAnimationFrame(render);
    }

    function settled(){
      var light=isLight(), indigo=cssv("--indigo","#27386B");
      ctx.clearRect(0,0,W,H); ctx.lineCap="round"; ctx.shadowBlur=0;
      for(var i=0;i<rows.length;i++){
        var row=rows[i];
        for(var r2=0;r2<row.runs.length;r2++){
          var run=row.runs[r2];
          for(var k=0;k<run.length;k++){ run[k].x=ox+run[k].tx*sc; run[k].y=oy+run[k].ty*sc; }
          ctx.strokeStyle=rgba(indigo,light?0.55:0.5);
          ctx.lineWidth=Math.max(.6, sc*(row.y>42&&row.y<60?1.05:0.75));
          ctx.beginPath();
          for(var k2=0;k2<run.length;k2++){ var pt=run[k2]; k2?ctx.lineTo(pt.x,pt.y):ctx.moveTo(pt.x,pt.y); }
          ctx.stroke();
          ctx.fillStyle=rgba(indigo,light?0.85:0.72);
          for(var k3=0;k3<run.length;k3++){ var pp=run[k3];
            ctx.beginPath(); ctx.arc(pp.x,pp.y,Math.max(.5,sc*0.34),0,6.283); ctx.fill(); }
        }
      }
    }

    return {
      start:function(){ size(); if(!rows.length) scan(); cancelAnimationFrame(raf);
        if(reduce){ settled(); } else { t0=0; raf=requestAnimationFrame(render); } },
      resize:function(){ size(); if(reduce) settled(); }
    };
  }

  var hero=Loom(document.getElementById("fig"),
    {pitch:2.15, dot:1.9, stagger:0.035, firstCut:3.4, seed:11, cuts:true, report:true});
  hero.start();
  var mini=document.getElementById("fig2");
  var small=mini ? Loom(mini,
    {pitch:2.6, dot:2.3, stagger:0.014, firstCut:1e9, seed:23, cuts:false, report:false}) : null;
  if(small) small.start();

  var rt; addEventListener("resize",function(){ clearTimeout(rt);
    rt=setTimeout(function(){ hero.resize(); if(small) small.resize(); },180); });

  /* the band: a woven strip with one thread cut and stamped */
  (function(){
    var g=document.getElementById("band"); if(!g) return;
    for(var x=6;x<200;x+=7){
      var v=document.createElementNS(NS,"line");
      v.setAttribute("x1",x); v.setAttribute("x2",x);
      v.setAttribute("y1",8); v.setAttribute("y2",112);
      v.setAttribute("stroke","var(--warp-2)"); v.setAttribute("stroke-width",.6);
      g.appendChild(v);
    }
    var cutRow=7;
    for(var i=0;i<13;i++){
      var y=12+i*8;
      if(i===cutRow){
        var a=document.createElementNS(NS,"line");
        a.setAttribute("x1",4); a.setAttribute("x2",96);
        a.setAttribute("y1",y); a.setAttribute("y2",y);
        a.setAttribute("stroke","var(--madder)"); a.setAttribute("stroke-width",2.6);
        a.setAttribute("stroke-linecap","round"); g.appendChild(a);
        var b=document.createElementNS(NS,"line");
        b.setAttribute("x1",130); b.setAttribute("x2",196);
        b.setAttribute("y1",y); b.setAttribute("y2",y);
        b.setAttribute("stroke","var(--madder)"); b.setAttribute("stroke-width",2.6);
        b.setAttribute("stroke-dasharray","3 4"); b.setAttribute("opacity",".45");
        g.appendChild(b);
        var t=document.createElementNS(NS,"text");
        t.setAttribute("x",101); t.setAttribute("y",y+3.4);
        t.setAttribute("fill","var(--madder)"); t.setAttribute("font-size","7.5");
        t.setAttribute("font-family","var(--mono)"); t.setAttribute("letter-spacing",".08em");
        t.textContent="CUT"; g.appendChild(t);
      } else {
        var l=document.createElementNS(NS,"line");
        l.setAttribute("x1",4); l.setAttribute("x2",196);
        l.setAttribute("y1",y); l.setAttribute("y2",y);
        l.setAttribute("stroke","var(--indigo)"); l.setAttribute("stroke-width",2.2);
        l.setAttribute("stroke-linecap","round"); l.setAttribute("opacity",".85");
        g.appendChild(l);
      }
    }
  })();

  /* theme — shares the "starlight-theme" key with the docs site's own control */
  document.getElementById("tg").addEventListener("click",function(){
    var cur=root.getAttribute("data-theme")
      || (matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light");
    var next=cur==="dark"?"light":"dark";
    root.setAttribute("data-theme",next);
    try{ localStorage.setItem("starlight-theme",next); }catch(e){}
    if(reduce){ hero.resize(); if(small) small.resize(); }
  });

  document.getElementById("copy").addEventListener("click",function(){
    var t=document.getElementById("qs").innerText, self=this;
    var done=function(){ self.textContent="Copied"; setTimeout(function(){self.textContent="Copy"},1500); };
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(t).then(done,done);
    } else { done(); }
  });

  if(!reduce){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target);} });
    },{rootMargin:"0px 0px -10% 0px"});
    document.querySelectorAll(".rv").forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll(".rv").forEach(function(el){ el.classList.add("in"); });
  }
})();
</script>
